# ---- Personal data (never commit) ----------------------------------
# The Letterboxd export contains every review written, and the caches
# hold the full viewing history in API form.
data/*
*.csv
*.json
!requirements.json

# App inputs — the only data committed. data/processed/<username>/ holds the tables the
# Streamlit app reads for each Letterboxd export (titles, ratings, predictions, summary
# figures and a display name — no review text), so the app can run from the repo,
# e.g. on Streamlit Community Cloud. **/ covers every user's folder.
!data/processed/
!data/processed/**/*.csv

# Raw exports, wherever they land
letterboxd-*/
*-utc/

# ---- Secrets -------------------------------------------------------
.env
.env.*
!.env.example
*.key

# ---- Jupyter -------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---- Python --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# ---- Tooling -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_convert/

# ---- Streamlit -----------------------------------------------------
.streamlit/secrets.toml

# ---- OS / editor ---------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Outputs -------------------------------------------------------
# Figures are regenerable; uncomment if you'd rather not track them.
# figures/
*.log
